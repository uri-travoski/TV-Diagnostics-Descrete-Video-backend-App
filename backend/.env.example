# TV Diagnostics Backend Configuration Example
# Copy this file to .env and configure as needed

# TV Diagnostics Security PINs
PIN_CODE=123456
NOTES_PIN=1234

# Server Port
PORT=8090

# Media Scanner Configuration
SCAN_ON_STARTUP=true
SCAN_INTERVAL_MINUTES=30
MOUNT_POLL_INTERVAL_SECONDS=5
VIDEO_DIRS=/videos

# Optional: GitHub Deployment Token
# GITHUB_USERNAME=your-username
# GITHUB_TOKEN=your-token
