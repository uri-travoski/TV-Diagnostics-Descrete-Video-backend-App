<?xml version="1.0" encoding="utf-8"?>
<!-- Filter bar pill: outline at rest, tinted when active (selected), solid white under the D-pad focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F1F5F9" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#333B82F6" />
            <stroke android:width="1dp" android:color="#803B82F6" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
