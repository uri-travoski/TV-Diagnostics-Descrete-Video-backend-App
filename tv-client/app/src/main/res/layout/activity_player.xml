<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Video only: no Media3 controller (its dark scrim dims the picture) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:use_controller="false"
        app:show_buffering="when_playing"
        app:shutter_background_color="#000000"
        app:resize_mode="fit" />

    <!-- Minimal bottom overlay: play/pause state, time, thin progress line. No background. -->
    <LinearLayout
        android:id="@+id/bottomOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="18dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/ivPlayState"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:alpha="0.6"
                android:src="@drawable/ic_pause"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvPlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#99000000"
                android:shadowRadius="3"
                android:shadowDx="0"
                android:shadowDy="1"
                android:text="00:00 / 00:00" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvSpeedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:shadowColor="#99000000"
                android:shadowRadius="3"
                android:text="▲ 1×" />
        </LinearLayout>

        <!-- Thin semi-transparent progress line -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#26FFFFFF" />

            <View
                android:id="@+id/progressFill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#99FFFFFF"
                android:scaleX="0" />
        </FrameLayout>
    </LinearLayout>

    <!-- Transparent playback speed menu, bottom right (opened with D-pad UP) -->
    <LinearLayout
        android:id="@+id/speedMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="52dp"
        android:background="@drawable/bg_speed_menu"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone" />

    <!-- ===== Phone / tablet (touch) controls; never shown on TV ===== -->

    <!-- Taps and double-taps on the picture (show controls / skip 10 s) -->
    <View
        android:id="@+id/gestureLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Double-tap skip feedback, left and right -->
    <TextView
        android:id="@+id/tvSeekBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="56dp"
        android:background="@drawable/bg_seek_feedback"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSeekForward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="56dp"
        android:background="@drawable/bg_seek_feedback"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/mobileControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Top: back + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_scrim_top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <ImageButton
                android:id="@+id/btnPlayerBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Centre: back 10 s, play / pause, forward 10 s -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/btnRewind"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_player_button"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back 10 seconds">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_replay"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="3dp"
                    android:text="10"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/bg_player_button"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"
                android:contentDescription="Play or pause" />

            <FrameLayout
                android:id="@+id/btnForward"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_player_button"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Forward 10 seconds">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:scaleX="-1"
                    android:src="@drawable/ic_replay"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="3dp"
                    android:text="10"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bottom: time, draggable seek bar, length, speed -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_scrim_bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="32dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvMobilePosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/accent_blue"
                android:progressBackgroundTint="#66FFFFFF"
                android:secondaryProgressTint="#99FFFFFF"
                android:thumbTint="@color/accent_blue"
                android:contentDescription="Position" />

            <TextView
                android:id="@+id/tvMobileDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="end"
                android:text="00:00"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnMobileSpeed"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="52dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:text="1×"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:contentDescription="Playback speed" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
