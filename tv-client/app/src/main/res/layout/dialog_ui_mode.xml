<?xml version="1.0" encoding="utf-8"?>
<!-- First launch: TV or phone? Works with a remote (D-pad + OK) and by touch. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvUiModeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Where are you using this app?"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The screens are set up for it. You can change this later in Settings."
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnModeTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical|start"
        android:background="@drawable/btn_tv_focus"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:stateListAnimator="@null"
        android:focusable="true"
        android:layout_marginBottom="12dp"
        android:text="📺   TV or TV box\nUse it with a remote control" />

    <Button
        android:id="@+id/btnModeMobile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical|start"
        android:background="@drawable/btn_tv_focus"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:stateListAnimator="@null"
        android:focusable="true"
        android:text="📱   Phone or tablet\nUse it with the touch screen" />
</LinearLayout>
