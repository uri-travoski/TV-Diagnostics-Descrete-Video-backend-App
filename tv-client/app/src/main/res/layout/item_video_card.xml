<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="7dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 16:9 tile: thumbnail, storyboard preview layer on top, title on a bottom shade -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:clickable="true"
        android:foreground="@drawable/bg_card_focus"
        android:background="@drawable/bg_card"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="@id/ivThumbnail"
            app:layout_constraintBottom_toBottomOf="@id/ivThumbnail"
            app:layout_constraintStart_toStartOf="@id/ivThumbnail"
            app:layout_constraintEnd_toEndOf="@id/ivThumbnail" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_card_shade"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintBottom_toBottomOf="@id/ivThumbnail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvCircleRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/bg_card_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/circle_filled"
            android:textSize="11sp"
            android:text="●"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvResBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/bg_card_badge"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:textColor="#CCFFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:text="HD"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvVideoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="9dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowRadius="3"
            android:text="Video Title"
            app:layout_constraintBottom_toBottomOf="@id/ivThumbnail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvDurationBadge" />

        <TextView
            android:id="@+id/tvDurationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:shadowColor="#CC000000"
            android:shadowRadius="3"
            android:text="00:00"
            app:layout_constraintBaseline_toBaselineOf="@id/tvVideoTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Watched progress line along the bottom edge -->
        <ProgressBar
            android:id="@+id/pbWatchProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent_blue"
            android:progressBackgroundTint="#33FFFFFF"
            app:layout_constraintBottom_toBottomOf="@id/ivThumbnail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tags / notes under the tile (only when present) -->
    <TextView
        android:id="@+id/tvTagsSnippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingStart="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#8093C5FD"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvNotesSnippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
