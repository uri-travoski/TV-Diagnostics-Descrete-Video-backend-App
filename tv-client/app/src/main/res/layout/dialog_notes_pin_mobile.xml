<?xml version="1.0" encoding="utf-8"?>
<!-- Phone Notes PIN prompt: dots on top, big keypad, Cancel underneath -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/card_dark"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="22dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/notes_pin_dialog_title"
        android:textColor="@color/text_white"
        android:textSize="19sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvNotesPinSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/notes_pin_dialog_hint"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView android:id="@+id/pinBox1" style="@style/PinBoxStyle.Mobile" />
        <TextView android:id="@+id/pinBox2" style="@style/PinBoxStyle.Mobile" />
        <TextView android:id="@+id/pinBox3" style="@style/PinBoxStyle.Mobile" />
        <TextView android:id="@+id/pinBox4" style="@style/PinBoxStyle.Mobile" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/notes_pin_invalid"
        android:textColor="@color/danger_red"
        android:textSize="13sp"
        android:visibility="gone"
        android:layout_marginBottom="6dp" />

    <GridLayout
        android:id="@+id/numPadGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:columnCount="3"
        android:rowCount="4">

        <Button android:id="@+id/btnKey1" style="@style/PinKeyStyle.Mobile" android:text="1" />
        <Button android:id="@+id/btnKey2" style="@style/PinKeyStyle.Mobile" android:text="2" />
        <Button android:id="@+id/btnKey3" style="@style/PinKeyStyle.Mobile" android:text="3" />
        <Button android:id="@+id/btnKey4" style="@style/PinKeyStyle.Mobile" android:text="4" />
        <Button android:id="@+id/btnKey5" style="@style/PinKeyStyle.Mobile" android:text="5" />
        <Button android:id="@+id/btnKey6" style="@style/PinKeyStyle.Mobile" android:text="6" />
        <Button android:id="@+id/btnKey7" style="@style/PinKeyStyle.Mobile" android:text="7" />
        <Button android:id="@+id/btnKey8" style="@style/PinKeyStyle.Mobile" android:text="8" />
        <Button android:id="@+id/btnKey9" style="@style/PinKeyStyle.Mobile" android:text="9" />
        <Button android:id="@+id/btnKeyBack" style="@style/PinKeyStyle.Mobile" android:text="⌫" />
        <Button android:id="@+id/btnKey0" style="@style/PinKeyStyle.Mobile" android:text="0" />
        <Button android:id="@+id/btnKeySubmit" style="@style/PinKeyStyle.Mobile" android:text="OK" />
    </GridLayout>

    <Button
        android:id="@+id/btnNotesPinCancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:text="@string/pin_btn_cancel"
        android:background="@drawable/btn_tv_focus"
        android:textAllCaps="false"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />
</LinearLayout>
