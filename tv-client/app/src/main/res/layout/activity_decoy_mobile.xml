<?xml version="1.0" encoding="utf-8"?>
<!-- Phone / tablet start screen: same diagnostics tools as the TV version, stacked in one column -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/decoy_subtitle"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnScreenTest"
            style="@style/MobileButton"
            android:text="@string/btn_screen_test" />

        <Button
            android:id="@+id/btnPingTest"
            style="@style/MobileButton"
            android:text="@string/btn_ping_test" />

        <Button
            android:id="@+id/btnServerCode"
            style="@style/MobileButton"
            android:text="@string/btn_server_code" />

        <!-- Shown when the start-up check finds a newer release on GitHub -->
        <Button
            android:id="@+id/btnAppUpdate"
            style="@style/MobileButton"
            android:text="Update available"
            android:textColor="@color/accent_green"
            android:visibility="gone" />

        <!-- Telemetry panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@color/card_dark"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Diagnostics Telemetry"
                android:textColor="@color/accent_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_display_res"
                    android:textColor="@color/text_muted" />
                <TextView
                    android:id="@+id/tvDisplayRes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_white"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_refresh_rate"
                    android:textColor="@color/text_muted" />
                <TextView
                    android:id="@+id/tvRefreshRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_white"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_ip_addr"
                    android:textColor="@color/text_muted" />
                <TextView
                    android:id="@+id/tvIpAddr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detecting..."
                    android:textColor="@color/accent_green"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_ping"
                    android:textColor="@color/text_muted" />
                <TextView
                    android:id="@+id/tvPingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textColor="@color/text_white" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLogOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:layout_marginTop="8dp"
                android:background="#050811"
                android:padding="12dp"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#4ADE80"
                android:text="[System Probe Initialized]\nInterface: wlan0 / eth0\nDirect Stream Support: OK\nReady for diagnostics scan." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
