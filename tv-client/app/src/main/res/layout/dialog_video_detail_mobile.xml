<?xml version="1.0" encoding="utf-8"?>
<!-- Phone video details: bottom sheet with the thumbnail, info and big play buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="10dp"
    android:paddingBottom="14dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <ScrollView
        android:id="@+id/svDetailBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivDetailThumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:background="@color/bg_dark"
                android:contentDescription="@null"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/circle_filled"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_blue"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDetailResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvDetailProgressInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvTagsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tags_header"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:visibility="gone"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvDetailTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#93C5FD"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvNotesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notes_header"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvDetailNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0F172A"
                android:padding="12dp"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:text="@string/no_notes" />
        </LinearLayout>
    </ScrollView>

    <!-- Main action first and biggest -->
    <Button
        android:id="@+id/btnResume"
        style="@style/MobileButton"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_primary"
        android:textStyle="bold"
        android:text="Resume from 00:00" />

    <Button
        android:id="@+id/btnPlayStart"
        style="@style/MobileButton"
        android:text="▶  Play from Start" />

    <Button
        android:id="@+id/btnResetVideoProgress"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackground"
        android:text="@string/btn_reset_progress"
        android:textAllCaps="false"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />
</LinearLayout>
