<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_dark"
    android:padding="26dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_settings"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Scrollable Settings Body to guarantee fit on any TV screen without cut-off -->
    <ScrollView
        android:id="@+id/svSettingsBody"
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Backend URL Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Backend Server URL (HTTP &amp; Port 8090):"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="#0F172A"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:hint="@string/default_server_url"
                    android:textColorHint="#475569"
                    android:inputType="textUri"
                    android:focusable="true"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/btnTestConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Test"
                    android:background="@drawable/btn_tv_focus"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvDeviceIpHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginBottom="14dp" />

            <!-- Change My Code: the signed-in user's own 6-digit vault code -->
            <TextView
                android:tag="vaultOnly"
                android:id="@+id/tvMyCodeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change My Code (6 Digits):"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:tag="vaultOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/etNewPin"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="#0F172A"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:hint="New code"
                    android:textColorHint="#475569"
                    android:inputType="numberPassword"
                    android:maxLength="6"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etConfirmPin"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="#0F172A"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:hint="Repeat new code"
                    android:textColorHint="#475569"
                    android:inputType="numberPassword"
                    android:maxLength="6"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnChangePin"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Change"
                    android:background="@drawable/btn_tv_focus"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:tag="vaultOnly"
                android:id="@+id/tvChangePinStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="6dp" />

            <View
                android:tag="vaultOnly"
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <!-- TV (remote) or phone / tablet (touch) screens -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screen Layout:"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#0F172A"
                android:padding="12dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvUiModeStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TV (remote control)"
                    android:textColor="@color/text_white"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnChangeUiMode"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/btn_tv_focus"
                    android:text="Change"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:focusable="true" />
            </LinearLayout>

            <!-- App Updates from GitHub Releases -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Updates:"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#0F172A"
                android:padding="12dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvUpdateStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Installed: v1.1.0"
                    android:textColor="@color/text_white"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/btn_tv_focus"
                    android:text="Check for Update"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Notes Feature Toggle Section -->
            <TextView
                android:tag="vaultOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video Notes Visibility (4-Digit PIN):"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:tag="vaultOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#0F172A"
                android:padding="12dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/tvNotesStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Status: OFF (Hidden)"
                    android:textColor="@color/text_white"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnToggleNotes"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/btn_tv_focus"
                    android:text="Enable Notes"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Dialog Actions (Pinned to Bottom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnSettingsCancel"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Cancel"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginEnd="10dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btnSettingsSave"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Save &amp; Connect"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:focusable="true" />
    </LinearLayout>

    <!-- App Version & Help Manual Display -->
    <TextView
        android:id="@+id/tvAppVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TV Diagnostics v1.0.3"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvAppHelpLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Web Manual &amp; Setup Guide: http://&lt;server-ip&gt;:8090/help"
        android:textColor="#38bdf8"
        android:textSize="10sp"
        android:gravity="center"
        android:layout_marginTop="3dp" />

</LinearLayout>
