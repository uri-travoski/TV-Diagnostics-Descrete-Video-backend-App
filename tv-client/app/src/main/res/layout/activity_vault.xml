<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="14dp">

    <!-- Unified Single Top Bar: Everything fits in 1 row -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- D-pad focusable Search Input -->
        <EditText
            android:id="@+id/etVaultSearch"
            android:layout_width="160dp"
            android:layout_height="38dp"
            android:background="@drawable/btn_tv_focus"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:hint="@string/search_hint"
            android:textColorHint="#475569"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:focusable="true"
            android:layout_marginEnd="6dp"
            android:nextFocusRight="@+id/filterAll"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <!-- Symbol-Only Rating Filters (D-pad focusable) -->
        <Button
            android:id="@+id/filterAll"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/category_all"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="4dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/etVaultSearch"
            android:nextFocusRight="@+id/filterContinue"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <Button
            android:id="@+id/filterContinue"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/category_continue"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="4dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/filterAll"
            android:nextFocusRight="@+id/filterLevel2"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <Button
            android:id="@+id/filterLevel2"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="●●"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/circle_filled"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/filterContinue"
            android:nextFocusRight="@+id/filterLevel1"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <Button
            android:id="@+id/filterLevel1"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="●"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/circle_filled"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/filterLevel2"
            android:nextFocusRight="@+id/filterUnrated"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <Button
            android:id="@+id/filterUnrated"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="○"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/circle_empty"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="6dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/filterLevel1"
            android:nextFocusRight="@+id/btnVaultTags"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <!-- Tag Selector Button -->
        <Button
            android:id="@+id/btnVaultTags"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="🏷 Tags"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="4dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/filterUnrated"
            android:nextFocusRight="@+id/btnClearTagFilter"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <!-- Quick Clear Tag Button -->
        <Button
            android:id="@+id/btnClearTagFilter"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="✕"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/danger_red"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            android:focusable="true"
            android:nextFocusLeft="@+id/btnVaultTags"
            android:nextFocusRight="@+id/btnVaultSort"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <!-- Sort Button -->
        <Button
            android:id="@+id/btnVaultSort"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="⇅ Sort"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/btnVaultTags"
            android:nextFocusRight="@+id/btnVaultSettings"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <!-- Spacer pushes settings & lock to right side -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Options / Settings Button -->
        <Button
            android:id="@+id/btnVaultSettings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="⚙ Options"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/btnVaultSort"
            android:nextFocusRight="@+id/btnLockVault"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <!-- Lock Button: ONLY lock icon "🔒" -->
        <Button
            android:id="@+id/btnLockVault"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:text="🔒"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/danger_red"
            android:textSize="15sp"
            android:focusable="true"
            android:nextFocusLeft="@+id/btnVaultSettings"
            android:nextFocusDown="@+id/rvVideoGrid" />
    </LinearLayout>

    <!-- TV Grid View for Videos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVideoGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@+id/filterAll" />

</LinearLayout>
