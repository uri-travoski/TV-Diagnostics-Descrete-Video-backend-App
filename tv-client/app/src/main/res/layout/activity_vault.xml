<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="16dp">

    <!-- Top Action & Rating Filter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vault_title"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Symbol-Only Rating Filters (D-pad focusable) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginStart="24dp">

            <Button
                android:id="@+id/filterAll"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/category_all"
                android:background="@drawable/btn_tv_focus"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"
                android:focusable="true"
                android:nextFocusRight="@+id/filterContinue"
                android:nextFocusDown="@+id/etVaultSearch" />

            <Button
                android:id="@+id/filterContinue"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/category_continue"
                android:background="@drawable/btn_tv_focus"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"
                android:focusable="true"
                android:nextFocusLeft="@+id/filterAll"
                android:nextFocusRight="@+id/filterLevel2"
                android:nextFocusDown="@+id/etVaultSearch" />

            <Button
                android:id="@+id/filterLevel2"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="●●"
                android:background="@drawable/btn_tv_focus"
                android:textColor="@color/circle_filled"
                android:textSize="14sp"
                android:layout_marginEnd="6dp"
                android:focusable="true"
                android:nextFocusLeft="@+id/filterContinue"
                android:nextFocusRight="@+id/filterLevel1"
                android:nextFocusDown="@+id/btnVaultTags" />

            <Button
                android:id="@+id/filterLevel1"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="●"
                android:background="@drawable/btn_tv_focus"
                android:textColor="@color/circle_filled"
                android:textSize="14sp"
                android:layout_marginEnd="6dp"
                android:focusable="true"
                android:nextFocusLeft="@+id/filterLevel2"
                android:nextFocusRight="@+id/filterUnrated"
                android:nextFocusDown="@+id/btnVaultTags" />

            <Button
                android:id="@+id/filterUnrated"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="○"
                android:background="@drawable/btn_tv_focus"
                android:textColor="@color/circle_empty"
                android:textSize="14sp"
                android:layout_marginEnd="6dp"
                android:focusable="true"
                android:nextFocusLeft="@+id/filterLevel1"
                android:nextFocusRight="@+id/btnVaultSettings"
                android:nextFocusDown="@+id/btnVaultTags" />
        </LinearLayout>

        <!-- Options / Settings Button -->
        <Button
            android:id="@+id/btnVaultSettings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="⚙ Settings"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            android:nextFocusLeft="@+id/filterUnrated"
            android:nextFocusRight="@+id/btnLockVault"
            android:nextFocusDown="@+id/btnVaultSort" />

        <!-- Lock / Revert Button -->
        <Button
            android:id="@+id/btnLockVault"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="🔒 Revert to Decoy"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/danger_red"
            android:textSize="11sp"
            android:focusable="true"
            android:nextFocusLeft="@+id/btnVaultSettings"
            android:nextFocusDown="@+id/btnVaultSort" />
    </LinearLayout>

    <!-- Search & Tag Filter Bar (Row 2) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- D-pad focusable Search Input -->
        <EditText
            android:id="@+id/etVaultSearch"
            android:layout_width="260dp"
            android:layout_height="38dp"
            android:background="@drawable/btn_tv_focus"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="@string/search_hint"
            android:textColorHint="#475569"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:focusable="true"
            android:layout_marginEnd="16dp"
            android:nextFocusUp="@+id/filterAll"
            android:nextFocusRight="@+id/btnVaultTags"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <!-- D-pad focusable Tag Selector Button (Supports 100+ tags via TagFilterDialog) -->
        <Button
            android:id="@+id/btnVaultTags"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="🏷 Tags: All"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true"
            android:nextFocusUp="@+id/filterLevel2"
            android:nextFocusLeft="@+id/etVaultSearch"
            android:nextFocusRight="@+id/btnClearTagFilter"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <!-- Quick Clear Tag Button -->
        <Button
            android:id="@+id/btnClearTagFilter"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="✕ Clear Tag"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/danger_red"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="6dp"
            android:visibility="gone"
            android:focusable="true"
            android:nextFocusUp="@+id/filterUnrated"
            android:nextFocusLeft="@+id/btnVaultTags"
            android:nextFocusRight="@+id/btnVaultSort"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- D-pad focusable Sort Button (Default: Added Newest) -->
        <Button
            android:id="@+id/btnVaultSort"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="⇅ Added (Newest)"
            android:background="@drawable/btn_tv_focus"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="10dp"
            android:focusable="true"
            android:nextFocusUp="@+id/btnVaultSettings"
            android:nextFocusLeft="@+id/btnVaultTags"
            android:nextFocusDown="@+id/rvVideoGrid" />
    </LinearLayout>

    <!-- TV Grid View for Videos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVideoGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@+id/btnVaultTags" />

</LinearLayout>
