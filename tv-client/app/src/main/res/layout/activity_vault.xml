<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:paddingStart="36dp"
    android:paddingEnd="36dp"
    android:paddingTop="20dp">

    <!-- Header: library name + count, options and lock on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tvVaultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vault_title"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVaultCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:text="" />

        <Button
            android:id="@+id/btnVaultSettings"
            style="@style/ChipStyle"
            android:text="⚙"
            android:textSize="14sp"
            android:nextFocusRight="@+id/btnLockVault"
            android:nextFocusDown="@+id/etVaultSearch" />

        <Button
            android:id="@+id/btnLockVault"
            style="@style/ChipStyle"
            android:layout_marginEnd="0dp"
            android:text="🔒"
            android:textSize="13sp"
            android:nextFocusLeft="@+id/btnVaultSettings"
            android:nextFocusDown="@+id/etVaultSearch" />
    </LinearLayout>

    <!-- Filter bar: search, rating / continue chips, tags, sort -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <EditText
            android:id="@+id/etVaultSearch"
            android:layout_width="220dp"
            android:layout_height="34dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="🔍  Search"
            android:textColorHint="#80F1F5F9"
            android:textColor="@color/chip_text"
            android:textSize="12sp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:focusable="true"
            android:nextFocusUp="@+id/btnVaultSettings"
            android:nextFocusRight="@+id/filterAll"
            android:nextFocusDown="@+id/rvVideoGrid" />

        <Button
            android:id="@+id/filterAll"
            style="@style/ChipStyle"
            android:text="@string/category_all"
            android:nextFocusUp="@+id/btnVaultSettings" />

        <Button
            android:id="@+id/filterContinue"
            style="@style/ChipStyle"
            android:text="@string/category_continue"
            android:nextFocusUp="@+id/btnVaultSettings" />

        <Button
            android:id="@+id/filterLevel2"
            style="@style/ChipStyle"
            android:text="●●"
            android:nextFocusUp="@+id/btnVaultSettings" />

        <Button
            android:id="@+id/filterLevel1"
            style="@style/ChipStyle"
            android:text="●"
            android:nextFocusUp="@+id/btnVaultSettings" />

        <Button
            android:id="@+id/filterUnrated"
            style="@style/ChipStyle"
            android:text="○"
            android:nextFocusUp="@+id/btnVaultSettings" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="14dp"
            android:background="#1FFFFFFF" />

        <Button
            android:id="@+id/btnVaultTags"
            style="@style/ChipStyle"
            android:text="# Tags"
            android:nextFocusUp="@+id/btnVaultSettings" />

        <Button
            android:id="@+id/btnClearTagFilter"
            style="@style/ChipStyle"
            android:text="✕"
            android:visibility="gone"
            android:nextFocusUp="@+id/btnVaultSettings" />

        <Button
            android:id="@+id/btnVaultSort"
            style="@style/ChipStyle"
            android:text="⇅ Sort"
            android:nextFocusUp="@+id/btnVaultSettings" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVideoGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingTop="4dp"
            android:paddingBottom="32dp"
            android:focusable="false"
            android:descendantFocusability="afterDescendants"
            android:nextFocusUp="@+id/filterAll" />

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone"
            android:text="" />
    </FrameLayout>

</LinearLayout>
