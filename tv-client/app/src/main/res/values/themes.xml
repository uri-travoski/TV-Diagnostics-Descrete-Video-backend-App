<resources>
    <!-- Base App Theme -->
    <style name="Theme.TVDiagnostics" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorAccent">@color/accent_blue</item>
    </style>

    <!-- Fullscreen Theme (Screen Test & Panic Screen) -->
    <style name="Theme.TVDiagnostics.Fullscreen" parent="Theme.TVDiagnostics">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Video Player Theme -->
    <style name="Theme.TVDiagnostics.Player" parent="Theme.TVDiagnostics">
        <item name="android:windowFullscreen">true</item>
        <item name="android:keepScreenOn">true</item>
        <item name="android:windowBackground">#000000</item>
    </style>
</resources>
